{
  "numero": 246,
  "titulo": "Te quiero, mi Señor",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "Te quiero, mi Señor;",
        "habita en mí,",
        "y vencedor seré",
        "por fe en ti."
      ]
    },
    {
      "tipo": "coro",
      "versos": [
        "Te quiero, sí, te quiero;",
        "siempre te anhelo;",
        "bendíceme, te ruego;",
        "acudo a ti."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "Te quiero, ¡oh Jesús!,",
        "mi Salvador.",
        "¡Oh!, hazme en verdad",
        "tu servidor."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
        "Tu voluntad, Señor,",
        "enséñame;",
        "y de tu gran amor,",
        "¡oh!, cólmame."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 4,
      "versos": [
        "¡Oh! mi gran Bienhechor,",
        "en tentación",
        "concédeme valor",
        "y protección."
      ]
    }
  ],
