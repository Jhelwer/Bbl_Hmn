{
  "numero": 94,
  "titulo": "Sangró mi soberano Dios",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "Sangró mi soberano Dios,",
        "murió mi Salvador.",
        "Su vida quiso entregar",
        "por mí, tan pecador."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "Y yo, contrito, al ver su cruz,",
        "el rostro encubriré;",
        "con lágrimas de gratitud",
        "mi alma inundaré."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
        "Mas no con llanto pagaré",
        "la deuda de su amor.",
        "Mi ser entero yo te doy,",
        "¡no puedo más, Señor!"
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 4,
      "versos": [
        "¡Oh, Salvador, ayúdame;",
        "que sea fiel a ti;",
        "y cuando en gloria reines tú,",
        "acuérdate de mí!"
      ]
    }
  ],
  "fuente": "TXT proporcionado por el usuario",
