{
  "numero": 444,
  "titulo": "No me pases",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "No me pases, no me olvides,",
        "tierno Salvador;",
        "muchos gozan tus mercedes,",
        "oye mi clamor."
      ]
    },
    {
      "tipo": "coro",
      "versos": [
        "Cristo, Cristo, oye tú mi voz;",
        "Salvador, tu gracia dame, oye mi clamor."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "Ante el trono de tu gracia",
        "hallo dulce paz;",
        "nada aquí mi alma sacia,",
        "tú eres mi solaz."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
        "Solo fío en tus bondades,",
        "guíame en tu luz,",
        "y mi alma no deseches,",
        "sálvame, Jesús."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 4,
      "versos": [
        "Fuente viva de consuelo",
        "eres para mí;",
        "mi alma pone en ti su anhelo,",
        "solamente en ti."
      ]
    }
  ],
