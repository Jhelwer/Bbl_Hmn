{
  "numero": 542,
  "titulo": "Amo tu sábado",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "Amo tu sábado;",
        "te adoraré, Señor;",
        "pues dulce paz encuentro en él,",
        "profunda y serena fe."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "Coro angelical",
        "tu creación cantó;",
        "elevaré, también, mi voz",
        "en gratitud y amor."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
        "Oh, nuestro Creador,",
        "tu generoso don",
        "me santifique en tu amor,",
        "y así veré tu faz."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 4,
      "versos": [
        "Y en la Santa Sion",
        "siempre entonaré",
        "himnos de eterna gratitud",
        "por tu inefable amor."
      ]
    }
  ],
