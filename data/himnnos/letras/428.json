  "titulo": "Su oveja soy",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "Junto a aguas tranquilas",
        "me apacienta Jesús;",
        "juntos andamos al atardecer.",
        "Todos somos ovejas",
        "de su tierno redil;",
        "su oveja soy.",
        "Aguas hay, protección,",
        "cuando estoy con el Señor Jesús.",
        "Soledad, aflicción,",
        "ya no temo con Jesús."
