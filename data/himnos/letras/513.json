      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "Muchos yacen sin valor,",
        "que pudieran ser",
        "nobles héroes del Señor,",
        "tal cual lo fue Daniel."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
