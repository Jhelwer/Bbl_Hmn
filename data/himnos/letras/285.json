{
  "numero": 285,
  "titulo": "Confío en Jesucristo",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "Confío en Jesucristo,",
        "quien en la cruz murió.",
        "Por esa muerte invicto",
        "al cielo marcho yo.",
        "Con sangre tan preciosa",
        "mis culpas lava él:",
        "la derramó copiosa",
        "por mí ya Emanuel."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "Me cubre tu justicia",
        "de plena protección;",
        "tú eres mi delicia,",
        "mi eterna salvación.",
        "Jesús, en ti descanso;",
        "reposo tú me das;",
        "tranquilo, pues, avanzo",
        "al cielo, donde estás."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
        "A disfrutar invitas.",
        "Acepto, mi Señor,",
        "delicias infinitas y celestial amor.",
        "Espero al fin mirarte,",
        "oír tu dulce voz;",
        "espero yo cantarte,",
        "mi Salvador, mi Dios."
      ]
    }
  ],
