{
  "numero": 15,
  "titulo": "Loámoste, ¡oh Dios!",
  "estrofas": [
    {
      "tipo": "estrofa",
      "numero": 1,
      "versos": [
        "Loámoste, ¡Oh Dios!,",
        "con alegre canción,",
        "porque en Cristo tu Hijo",
        "nos diste perdón."
      ]
    },
    {
      "tipo": "coro",
      "versos": [
        "¡Aleluya! Te alabamos.",
        "¡Cuán grande es tu amor!",
        "¡Aleluya! Te adoramos,",
        "bendito Señor."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 2,
      "versos": [
        "A ti, oh Señor,",
        "que tu trono de luz",
        "has dejado por darnos",
        "perdón en la cruz."
      ]
    },
    {
      "tipo": "estrofa",
      "numero": 3,
      "versos": [
        "Te damos loor,",
        "santo Consolador,",
        "que nos llenas de gozo",
        "y santo valor."
      ]
    }
  ],
